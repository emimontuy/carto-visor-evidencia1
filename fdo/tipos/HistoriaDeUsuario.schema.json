{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emimontuy/carto-visor-evidencia1/blob/main/fdo/tipos/HistoriaDeUsuario.schema.json",
  "title": "HistoriaDeUsuario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "prioridad",
    "titulo",
    "como",
    "quiero",
    "para",
    "criterios_de_aceptacion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HU-[0-9]{2}$"
    },
    "prioridad": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "titulo": {
      "type": "string"
    },
    "como": {
      "type": "string"
    },
    "quiero": {
      "type": "string"
    },
    "para": {
      "type": "string"
    },
    "texto": {
      "type": "string"
    },
    "criterios_de_aceptacion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "elementos_del_visor_ideal": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historias_de_origen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
